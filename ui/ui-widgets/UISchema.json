{
  "sections": [
    {
      "section-id": "main-content",
      "section-title": "Personal Information",
      "section-editable": false,
      "panels": [
        {
          "panel-id": "personal-details-card",
          "panel-orientation": "horizontal",
          "panels": [
            {
              "panel-id": "personal-left-column",
              "panel-orientation": "vertical",
              "widgets": [
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Name",
                  "widget-id": "name",
                  "widget-data-path": "person.name",
                  "widget-data-default": "Sarah Elizabeth",
                  "widget-required": true,
                  "widget-readonly": true
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "ID",
                  "widget-id": "id",
                  "widget-data-path": "person.id",
                  "widget-data-default": "1234567890",
                  "widget-readonly": true
                },
                {
                  "widget": "date",
                  "widget-type": "input",
                  "widget-label": "DOB",
                  "widget-id": "dob",
                  "widget-data-path": "person.dob",
                  "widget-data-default": "1980-01-25",
                  "widget-required": true,
                  "widget-readonly": true,
                  "widget-data-format": {
                    "dateFormat": "DD/MM/YYYY",
                    "dateConstraint": "past-only"
                  },
                  "widget-data-options": {
                    "action": "disable",
                    "maxDate": "today",
                    "minDate": "1900-01-01",
                    "condition": {
                      "field": "person.estimated_age",
                      "operator": "notEmpty"
                    }
                  }
                }
              ]
            },
            {
              "panel-id": "personal-center-column",
              "panel-orientation": "vertical",
              "widgets": [
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Phone",
                  "widget-id": "phone",
                  "widget-data-path": "person.phone",
                  "widget-data-default": "12345 67890",
                  "widget-required": true,
                  "widget-readonly": true
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Mail ID",
                  "widget-id": "email",
                  "widget-data-path": "person.email",
                  "widget-data-default": "abcd@gmail.com",
                  "widget-readonly": true
                },
                {
                  "widget": "number",
                  "widget-type": "input",
                  "widget-label": "Estimated Age",
                  "widget-id": "estimated_age",
                  "widget-data-path": "person.estimated_age",
                  "widget-readonly": true,
                  "widget-data-format": {
                    "numericType": "integer",
                    "allowSigned": false
                  },
                  "widget-data-validation": {
                    "min": 0,
                    "max": 120
                  }
                }
              ]
            },
            {
              "panel-id": "personal-right-column",
              "panel-orientation": "vertical",
              "widgets": [
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Village",
                  "widget-id": "village",
                  "widget-data-path": "address.village",
                  "widget-data-default": "Village Name",
                  "widget-readonly": true
                },
                {
                  "widget": "select",
                  "widget-type": "input",
                  "widget-label": "Zone",
                  "widget-id": "zone",
                  "widget-data-path": "address.zone",
                  "widget-data-default": "south",
                  "widget-required": true,
                  "widget-readonly": true,
                  "widget-data-source": {
                    "type": "static",
                    "options": [
                      { "label": "North Zone", "value": "north" },
                      { "label": "South Zone", "value": "south" },
                      { "label": "East Zone", "value": "east" },
                      { "label": "West Zone", "value": "west" }
                    ]
                  }
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Area",
                  "widget-id": "area",
                  "widget-data-path": "address.area",
                  "widget-data-default": "Area Name",
                  "widget-readonly": true,
                  "widget-data-options": {
                    "action": "show",
                    "condition": {
                      "field": "address.zone",
                      "operator": "equals",
                      "value": "south"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "panel-id": "other-details-1-card",
          "panel-orientation": "horizontal",
          "panels": [
            {
              "panel-id": "other-details-1-panel",
              "panel-orientation": "vertical",
              "widgets": [
                {
                  "widget": "select",
                  "widget-type": "input",
                  "widget-label": "Category",
                  "widget-id": "category_1",
                  "widget-data-path": "other.category1",
                  "widget-data-default": "type_a",
                  "widget-readonly": true,
                  "widget-data-source": {
                    "type": "static",
                    "options": [
                      { "label": "Type A", "value": "type_a" },
                      { "label": "Type B", "value": "type_b" },
                      { "label": "Type C", "value": "type_c" }
                    ]
                  }
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Details",
                  "widget-id": "details1",
                  "widget-data-path": "other.details1",
                  "widget-data-default": "Details 01",
                  "widget-readonly": true
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Details",
                  "widget-id": "details2",
                  "widget-data-path": "other.details2",
                  "widget-data-default": "Details 02",
                  "widget-readonly": true
                }
              ]
            },
            {
              "panel-id": "other-details-2-panel",
              "panel-orientation": "vertical",
              "widgets": [
                {
                  "widget": "number",
                  "widget-type": "input",
                  "widget-label": "Score",
                  "widget-id": "score",
                  "widget-data-path": "other.score",
                  "widget-data-default": 42,
                  "widget-readonly": true,
                  "widget-data-format": {
                    "numericType": "decimal",
                    "decimalPlaces": 2
                  },
                  "widget-data-validation": {
                    "min": 0,
                    "max": 100
                  }
                },
                {
                  "widget": "text",
                  "widget-type": "input",
                  "widget-label": "Details",
                  "widget-id": "details3",
                  "widget-data-path": "other.details3",
                  "widget-data-default": "Details 03",
                  "widget-readonly": true
                }
              ]
            }
          ]
        },
        {
          "panel-id": "other-details-2-card",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "text",
              "widget-type": "input",
              "widget-label": "Details",
              "widget-id": "details4",
              "widget-data-path": "other.details4",
              "widget-data-default": "Details 01",
              "widget-readonly": true
            },
            {
              "widget": "text",
              "widget-type": "input",
              "widget-label": "Details",
              "widget-id": "details5",
              "widget-data-path": "other.details5",
              "widget-data-default": "Details 02",
              "widget-readonly": true
            },
            {
              "widget": "text",
              "widget-type": "input",
              "widget-label": "Details",
              "widget-id": "details6",
              "widget-data-path": "other.details6",
              "widget-data-default": "Details 03",
              "widget-readonly": true
            }
          ]
        }
      ]
    }
  ]
}
