// Individual supporting documents — 3 columns × 3 file widgets (panel file widgets, not section-supporting-documents).
// Edit mode: Upload | View | Delete per field. Read mode: "Label: view" or "-".

{
  "section-id": "individual_supporting_documents",
  "section-title": "supporting_documents",
  "section-editable": true,
  "section-supporting-documents": [],
  "panels": [
    {
      "panel-id": "panel_individual_documents_main",
      "panel-orientation": "horizontal",
      "panels": [
        {
          "panel-id": "panel_supporting_docs_1",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "file",
              "widget-id": "national_id_front",
              "widget-type": "input",
              "widget-label": "National ID (Front)",
              "widget-required": true,
              "widget-data-path": "national_id_front",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "national_id_back",
              "widget-type": "input",
              "widget-label": "National ID (Back)",
              "widget-required": true,
              "widget-data-path": "national_id_back",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "passport_copy",
              "widget-type": "input",
              "widget-label": "Passport Copy",
              "widget-required": false,
              "widget-data-path": "passport_copy",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            }
          ]
        },
        {
          "panel-id": "panel_supporting_docs_2",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "file",
              "widget-id": "proof_of_address",
              "widget-type": "input",
              "widget-label": "Proof of Address",
              "widget-required": true,
              "widget-data-path": "proof_of_address",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "birth_certificate",
              "widget-type": "input",
              "widget-label": "Birth Certificate",
              "widget-required": false,
              "widget-data-path": "birth_certificate",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "income_proof",
              "widget-type": "input",
              "widget-label": "Income Proof",
              "widget-required": false,
              "widget-data-path": "income_proof",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png,.doc,.docx",
                "multiple": false
              }
            }
          ]
        },
        {
          "panel-id": "panel_supporting_docs_3",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "file",
              "widget-id": "bank_statement",
              "widget-type": "input",
              "widget-label": "Bank Statement",
              "widget-required": false,
              "widget-data-path": "bank_statement",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "disability_certificate",
              "widget-type": "input",
              "widget-label": "Disability Certificate",
              "widget-required": false,
              "widget-data-path": "disability_certificate",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            },
            {
              "widget": "file",
              "widget-id": "marriage_certificate",
              "widget-type": "input",
              "widget-label": "Marriage Certificate",
              "widget-required": false,
              "widget-data-path": "marriage_certificate",
              "widget-data-options": {
                "accept": ".pdf,.jpg,.jpeg,.png",
                "multiple": false
              }
            }
          ]
        }
      ]
    }
  ]
}
